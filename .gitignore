# ==========================================================
# 一、Rust 官方口径（GitHub Rust.gitignore 模板原文 6 条）
# ==========================================================
# Generated by Cargo: will have compiled files and executables
debug
/target
# These are backup files generated by rustfmt
**/*.rs.bk
# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
# Generated by cargo mutants: mutation testing data
**/mutants.out*/
# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# ==========================================================
# 二、本项目补充（HTTP 服务 + 手工打包分发 + 运行期改写 txt）
# ==========================================================
# cargo build --release 后整理发布包的目录
/dist
# 修改配置前自动生成的备份（config.toml 中 backup = true 时产生）
*.bak
# 运行日志
*.log
logs/

# ==========================================================
# 三、本地环境与编辑器垃圾
# ==========================================================
.env
.env.*
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

# 说明：Cargo.lock 必须提交（应用项目锁定依赖版本，等价于 uv.lock）
# 说明：config.toml 是分发必需文件（exe + config.toml），需要提交
